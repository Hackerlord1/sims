{
  "name": "sims",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/preflight.mjs && node server.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:prod": "playwright test --config playwright.prod.config.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "setup:env": "node scripts/setup-env.mjs",
    "db:local:init": "node scripts/db-local.mjs init",
    "db:local:start": "node scripts/db-local.mjs start",
    "db:local:stop": "node scripts/db-local.mjs stop",
    "db:local:status": "node scripts/db-local.mjs status",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "worker": "node --env-file-if-exists=.env --conditions=react-server --import tsx scripts/worker.ts",
    "samples": "tsx scripts/generate-samples.ts",
    "load-data": "node --env-file-if-exists=.env --conditions=react-server --import tsx scripts/load-test-data.ts",
    "perf": "node --env-file-if-exists=.env --conditions=react-server --import tsx scripts/perf.ts",
    "templates": "node --env-file-if-exists=.env --conditions=react-server --import tsx scripts/export-templates.ts",
    "create-admin": "node --env-file-if-exists=.env --conditions=react-server --import tsx scripts/create-admin.ts",
    "verify-storage": "node --env-file-if-exists=.env --conditions=react-server --import tsx scripts/verify-storage.ts",
    "verify-db": "node --env-file-if-exists=.env --conditions=react-server --import tsx scripts/verify-database.ts",
    "docs": "node --env-file-if-exists=.env --conditions=react-server --import tsx scripts/generate-docs.ts && prettier --write docs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run --project unit --project component",
    "test:integration": "vitest run --project integration",
    "reparse": "node --env-file-if-exists=.env --conditions=react-server --import tsx scripts/reparse-statements.ts"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/adapter-mariadb": "6.19.3",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tanstack/react-query": "^5.104.0",
    "clsx": "^2.1.1",
    "cytoscape": "^3.34.3",
    "decimal.js": "^10.6.0",
    "docx": "^9.8.1",
    "exceljs": "^4.4.0",
    "framer-motion": "^13.4.6",
    "jszip": "^3.10.2",
    "lucide-react": "^1.49.0",
    "next": "16.3.7",
    "otpauth": "^9.5.2",
    "papaparse": "^5.7.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.89.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "swagger-ui-dist": "^5.33.0",
    "tailwind-merge": "^3.7.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.0",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "6.19.3",
    "supertest": "^7.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "unrs-resolver@1.12.2": true,
    "@scarf/scarf": false
  },
  "prisma": {
    "seed": "node --conditions=react-server --import tsx prisma/seed.ts"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "@prisma/config": {
      "deepmerge-ts": "^8.0.2"
    },
    "@prisma/adapter-mariadb": {
      "mariadb": "3.4.7"
    }
  }
}
