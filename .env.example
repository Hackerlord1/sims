# Copy to .env, or run `npm run setup:env` to generate one with random secrets.
# MariaDB 10.11 / MySQL-compatible. Local development: `npm run db:local:init` creates the database
# and user from this URL on port 3307. Production (cPanel): the database user and database created in
# "MySQL Databases", e.g. mysql://cpaneluser_sims:PASSWORD@localhost:3306/cpaneluser_sims
# connection_limit = pool size per Node process; keep (processes × limit) under the host's per-user
# connection limit (18 on the current host). See docs/DEPLOYMENT.md.
DATABASE_URL="mysql://sims:CHANGE_ME@127.0.0.1:3307/sims?connection_limit=5"
# Used by docker-compose.yml only.
MARIADB_PORT=3307
MARIADB_PASSWORD=CHANGE_ME

# 32 random bytes, base64 (node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
SESSION_SECRET=
DATA_ENCRYPTION_KEY=

APP_URL=http://localhost:3000
# Evidence, statements and generated reports. Must be outside the public web directory.
STORAGE_DIR=./storage

# Development-only demo data and accounts. The app refuses to start with DEMO_MODE=true in production.
DEMO_MODE=false
DEMO_ADMIN_PASSWORD=
DEMO_USERS_PASSWORD=

# Background jobs (statement parsing, large imports, reminders): true = inside the web server,
# false = run `npm run worker` as a separate process.
JOBS_INLINE=true
# Statement parser: python (pandas, used when Python + pandas + pdfplumber are installed) or node.
STATEMENT_PARSER=python
# PYTHON_BIN=python3

# Optional: malware scanning of every upload. An HTTP endpoint that receives the file and answers
# { "clean": true|false }. Without it uploads are stored with scan status NOT_SCANNED.
# MALWARE_SCAN_URL=http://clamav-rest:8080/scan

# Not implemented yet (integration points only): OCR for scanned statement PDFs (they go to manual
# review) and Microsoft Entra ID sign-in (User.externalIdentityId is reserved for it).
