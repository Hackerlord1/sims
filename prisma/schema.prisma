// ═════════════════ Access requests and data-change approval ═════════════════

enum AccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ChangeRequestStatus {
  PENDING
  APPLIED
  REJECTED
  WITHDRAWN
  FAILED
}

enum ChangeOperation {
  CREATE
  UPDATE
  IMPORT
}

/// Submitted from the sign-in screen by someone without an account. An administrator decides the
/// role, units (company/branch scopes), clearance and restrictions when approving it.
model AccessRequest {
  id              String              @id @default(cuid())
  reference       String              @unique
  fullName        String
  username        String? // chosen by the requester; null only on requests made before it was asked
  // Argon2 hash of the password the requester chose. Used for the account on approval and cleared
  // once the request is decided. Never returned by the API.
  passwordHash    String?             @db.VarChar(255)
  email           String?             @db.VarChar(254)
  telephone       String?
  employeeNumber  String?
  jobTitle        String?
  unit            String? // the department or branch the person says they work in (free text)
  requestedRole   RoleCode?
  justification   String?             @db.Text
  status          AccessRequestStatus @default(PENDING)
  ipAddress       String?
  createdAt       DateTime            @default(now())
  decidedById     String?
  decidedAt       DateTime?
  decisionComment String?             @db.Text
  createdUserId   String?             @unique

  @@index([status, createdAt])
  @@index([email])
  @@index([username])
}

/// A create, edit or import of a record type that needs approval. Validated when submitted and
/// applied only when a different user with approval rights approves it.
model ChangeRequest {
  id              String              @id @default(cuid())
  reference       String              @unique
  resourceKey     String
  operation       ChangeOperation
  recordId        String? // record being edited, or the import batch
  caseId          String?
  summary         String              @db.Text
  payload         Json
  baseVersion     Int?
  status          ChangeRequestStatus @default(PENDING)
  requestedById   String
  requestedAt     DateTime            @default(now())
  reviewerId      String?
  reviewedAt      DateTime?
  reviewComment   String?             @db.Text
  appliedRecordId String?
  failureReason   String?             @db.Text

  requestedBy User  @relation("ChangeRequester", fields: [requestedById], references: [id])
  reviewer    User? @relation("ChangeReviewer", fields: [reviewerId], references: [id])
  case        Case? @relation(fields: [caseId], references: [id])

  @@index([status, requestedAt])
  @@index([requestedById, status])
  @@index([resourceKey, recordId, status])
}
