  requesterReauthAt DateTime
  approverId        String?
  approverReauthAt  DateTime?
  decidedAt         DateTime?
  decisionComment   String?               @db.Text
  executedAt        DateTime?

  @@index([status])
}

// Authorises an approved permanent-deletion transaction to remove one case's append-only history.
// The purge inserts (caseId, CONNECTION_ID()) inside its transaction and deletes the row again
// before committing, so the token is never visible to any other connection. The history triggers
// and the Case delete trigger accept a delete only while a token for that case exists on the
// current connection (see the guards migration). Not used outside permanent-deletion.ts.
model PurgeToken {
  caseId       String
  connectionId BigInt   @db.UnsignedBigInt
  createdAt    DateTime @default(now())

  @@id([caseId, connectionId])
}

model Job {
  id         String    @id @default(cuid())
  type       String // STATEMENT_PARSE | IMPORT_COMMIT | REMINDER_SWEEP
  payload    Json
  status     JobStatus @default(QUEUED)
  attempts   Int       @default(0)
  runAfter   DateTime  @default(now())
  lastError  String?   @db.Text
  result     Json?
  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  @@index([status, runAfter])
  // Job claiming (src/server/jobs/queue.ts) reads QUEUED rows in createdAt order with FOR UPDATE
  // SKIP LOCKED. Without this index InnoDB locks every queued row before sorting, and concurrent
  // workers then skip all of them; with it, each worker locks only the row it takes.
  @@index([status, createdAt])
}

