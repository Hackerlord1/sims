// ═════════════════════ Organisation & identity ═════════════════════

model Company {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())

  branches Branch[]
  cases    Case[]
  scopes   UserScope[]
  users    User[]
}

model Branch {
  id        String   @id @default(cuid())
  companyId String
  code      String
  name      String
  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())

  company Company     @relation(fields: [companyId], references: [id])
  cases   Case[]
  scopes  UserScope[]
  users   User[]

  @@unique([companyId, code])
}

model Department {
  id     String  @id @default(cuid())
  name   String  @unique
  isDemo Boolean @default(false)
  users  User[]
}

model User {
  id                 String          @id @default(cuid())
  username           String          @unique
  email              String          @unique @db.VarChar(254)
  fullName           String
  employeeNumber     String?         @unique
  telephone          String?
  jobTitle           String?
  role               RoleCode
  status             UserStatus      @default(ACTIVE)
  clearance          Confidentiality @default(STANDARD)
  companyId          String?
  branchId           String?
  departmentId       String?
  passwordHash       String          @db.VarChar(255)
  passwordChangedAt  DateTime?
  failedLoginCount   Int             @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  // Prepared for Microsoft Entra ID: the object id of the linked directory account.
  externalIdentityId String?         @unique
  mfaSecret          String?         @db.Text // AES-256-GCM encrypted
  mfaEnabled         Boolean         @default(false)
  // Enrolment in progress: the new secret only replaces mfaSecret once a code from it is confirmed.
  mfaPendingSecret   String?         @db.Text // AES-256-GCM encrypted
  // Last accepted TOTP time step, so a code cannot be replayed within its validity window.
  mfaLastUsedStep    Int?
  preferences        Json? // { theme, fontScale, reducedMotion, highContrast }
  isDemoAdmin        Boolean         @default(false)
  isDemo             Boolean         @default(false)
  // Per-user restrictions on top of the role matrix, as "MODULE:ACTION" (e.g. "EXPENSES:EDIT").
  // They can only take permissions away; "MODULE:VIEW" removes the whole module.
  permissionDenials  Json // string[]
  // May approve other people's pending data changes (system administrators always may).
  dataApprover       Boolean         @default(false)
  version            Int             @default(1)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  company    Company?    @relation(fields: [companyId], references: [id])
  branch     Branch?     @relation(fields: [branchId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])

  sessions        Session[]
  resetTokens     PasswordResetToken[]
  scopes          UserScope[]
  assignments     CaseAssignment[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  leadCases       Case[]               @relation("CaseLead")
  supervisedCases Case[]               @relation("CaseSupervisor")
  createdCases    Case[]               @relation("CaseCreator")
  subFiles        SubFile[]            @relation("SubFileInvestigator")
  tasksAssigned   Task[]               @relation("TaskAssignee")
  workLogs        WorkLog[]            @relation("WorkLogInvestigator")
  workLogsOwned   WorkLog[]            @relation("WorkLogResponsible")
  expenses        Expense[]            @relation("ExpenseEmployee")
  advances        Advance[]            @relation("AdvanceEmployee")
  evidenceUploads Evidence[]           @relation("EvidenceUploader")
  evidenceAccess  EvidenceAccess[]
  custodyEvents   CustodyEvent[]
  changeRequests  ChangeRequest[]      @relation("ChangeRequester")
  changeReviews   ChangeRequest[]      @relation("ChangeReviewer")

  @@index([role])
  @@index([status])
}

model UserScope {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  branchId  String? // null = all branches of the company
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id])
  branch  Branch? @relation(fields: [branchId], references: [id])

  @@unique([userId, companyId, branchId])
}

model Session {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  userId      String
  expiresAt   DateTime
  lastSeenAt  DateTime  @default(now())
  mfaVerified Boolean   @default(false)
  // Set by a successful password re-entry; sensitive actions require it to be recent.
  reauthAt    DateTime?
  ipAddress   String?
  userAgent   String?   @db.VarChar(300)
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ReferenceCounter {
  key       String   @id
  value     Int
  updatedAt DateTime @updatedAt
}

model SystemSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt
}

// ═════════════════════════════ Cases ═════════════════════════════

model Case {
  id                         String             @id @default(cuid())
  reference                  String             @unique @db.VarChar(300)
  title                      String             @db.VarChar(300)
  companyId                  String
  businessUnit               String?            @db.VarChar(300)
  branchId                   String?
  location                   String?            @db.VarChar(300)
  category                   CaseCategory
  description                String?            @db.MediumText
  allegationSummary          String?            @db.MediumText
  referralSource             String?            @db.VarChar(300)
  openedAt                   DateTime           @default(now())
  incidentDate               DateTime?
  incidentPeriodFrom         DateTime?
  incidentPeriodTo           DateTime?
  leadInvestigatorId         String?
  supervisingManagerId       String?
  priority                   Priority           @default(MEDIUM)
  confidentiality            Confidentiality    @default(CONFIDENTIAL)
  financialRisk              RiskLevel          @default(MEDIUM)
  status                     CaseStatus         @default(DRAFT)
  stage                      InvestigationStage @default(INTAKE)
  targetClosureDate          DateTime?
  actualClosureDate          DateTime?
  closureReason              String?            @db.VarChar(300)
  currency                   String             @default("KES") @db.VarChar(3)
  // Investigator-entered exposure. Recovered, written-off, remaining exposure, unsupported invoice
  // value, bad-cheque value and all costs are derived from their source records, never typed in.
  grossAmount                Decimal            @default(0) @db.Decimal(18, 2)
  amountDemanded             Decimal            @default(0) @db.Decimal(18, 2)
  amountDisputed             Decimal            @default(0) @db.Decimal(18, 2)
  amountAcknowledged         Decimal            @default(0) @db.Decimal(18, 2)
  amountConfirmedRecoverable Decimal            @default(0) @db.Decimal(18, 2)
  legalHold                  Boolean            @default(false)
  lastActivityAt             DateTime           @default(now())
  isDemo                     Boolean            @default(false)
  version                    Int                @default(1)
  createdById                String
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt
  isDeleted                  Boolean            @default(false)
  deletedAt                  DateTime?
  deletedById                String?
  deletionReason             String?            @db.Text
  deletionBatchId            String?
  restoredAt                 DateTime?
  restoredById               String?
  restorationReason          String?            @db.Text
  archivedAt                 DateTime?

  company            Company @relation(fields: [companyId], references: [id])
  branch             Branch? @relation(fields: [branchId], references: [id])
  leadInvestigator   User?   @relation("CaseLead", fields: [leadInvestigatorId], references: [id])
  supervisingManager User?   @relation("CaseSupervisor", fields: [supervisingManagerId], references: [id])
  createdBy          User    @relation("CaseCreator", fields: [createdById], references: [id])

  assignments     CaseAssignment[]
  statusHistory   CaseStatusHistory[]
  reopenings      CaseReopening[]
  closures        CaseClosure[]
  subFiles        SubFile[]
  parties         Party[]
  invoices        Invoice[]
  cheques         Cheque[]
  interviews      Interview[]
  statements      PartyStatement[]
  evidence        Evidence[]
  workLogs        WorkLog[]
  tasks           Task[]
  findings        Finding[]
  criminalMatters CriminalMatter[]
  civilMatters    CivilMatter[]
  disciplinary    DisciplinaryCase[]
  writeOffs       WriteOff[]
  expenses        Expense[]
  advances        Advance[]
  budgets         Budget[]
  recoveries      Recovery[]
  finStatements   FinancialStatement[]
  knownAccounts   KnownAccount[]
  reports         GeneratedReport[]

  changeRequests ChangeRequest[]

  @@index([status, isDeleted])
  @@index([companyId, branchId])
  @@index([leadInvestigatorId])
  @@index([priority])
  @@index([openedAt])
  @@index([lastActivityAt])
}

model CaseAssignment {
  id           String             @id @default(cuid())
  caseId       String
  userId       String
  role         CaseAssignmentRole
  active       Boolean            @default(true)
  assignedById String?
  createdAt    DateTime           @default(now())
  endedAt      DateTime?

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@unique([caseId, userId, role])
  @@index([userId, active])
}

model CaseStatusHistory {
  id          String      @id @default(cuid())
  caseId      String
  fromStatus  CaseStatus?
  toStatus    CaseStatus
  reason      String?     @db.Text
  changedById String
  changedAt   DateTime    @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, changedAt])
}

model CaseClosure {
  id         String   @id @default(cuid())
  caseId     String
  reason     String   @db.Text
  summary    String   @db.MediumText
  checklist  Json // snapshot of the closure checks at closure time
  closedById String
  closedAt   DateTime @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

model CaseReopening {
  id             String     @id @default(cuid())
  caseId         String
  reason         String     @db.Text
  newInformation String     @db.MediumText
  previousStatus CaseStatus
  reopenedById   String
  reopenedAt     DateTime   @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

// ═════════════════════════ Sub-files ═════════════════════════

model SubFile {
  id                String        @id @default(cuid())
  reference         String        @unique @db.VarChar(300)
  caseId            String
  sequence          Int
  title             String        @db.VarChar(300)
  location          String?       @db.VarChar(300)
  allegation        String?       @db.MediumText
  transactionType   String?       @db.VarChar(300)
  periodFrom        DateTime?
  periodTo          DateTime?
  investigatorId    String?
  amountInvolved    Decimal       @default(0) @db.Decimal(18, 2)
  status            SubFileStatus @default(OPEN)
  findings          String?       @db.MediumText
  recommendation    String?       @db.MediumText
  targetDate        DateTime?
  isDemo            Boolean       @default(false)
  version           Int           @default(1)
  createdById       String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  isDeleted         Boolean       @default(false)
  deletedAt         DateTime?
  deletedById       String?
  deletionReason    String?       @db.Text
  deletionBatchId   String?
  restoredAt        DateTime?
  restoredById      String?
  restorationReason String?       @db.Text
  archivedAt        DateTime?

  case           Case                 @relation(fields: [caseId], references: [id])
  investigator   User?                @relation("SubFileInvestigator", fields: [investigatorId], references: [id])
  invoices       Invoice[]
  cheques        Cheque[]
  evidence       Evidence[]
  workLogs       WorkLog[]
  tasks          Task[]
  expenses       Expense[]
  recoveries     Recovery[]
  statements     FinancialStatement[]
  findingRecords Finding[]
  writeOffs      WriteOff[]

  @@unique([caseId, sequence])
  @@index([caseId, isDeleted])
}

// ═════════════════════════ Parties ═════════════════════════

model Party {
  id                   String          @id @default(cuid())
  caseId               String
  role                 PartyRole
  kind                 PartyKind       @default(INDIVIDUAL)
  name                 String          @db.VarChar(300)
  idNumber             String?         @db.VarChar(300) // sensitive; masked in lists
  telephone            String?         @db.VarChar(300)
  email                String?         @db.VarChar(254)
  address              String?         @db.Text
  organisation         String?         @db.VarChar(300)
  employeeNumber       String?         @db.VarChar(300)
  customerCode         String?         @db.VarChar(300)
  relationshipToCase   String?         @db.VarChar(300)
  accessClassification Confidentiality @default(CONFIDENTIAL)
  notes                String?         @db.MediumText
  isDemo               Boolean         @default(false)
  version              Int             @default(1)
  createdById          String
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  isDeleted            Boolean         @default(false)
  deletedAt            DateTime?
  deletedById          String?
  deletionReason       String?         @db.Text
  deletionBatchId      String?
  restoredAt           DateTime?
  restoredById         String?
  restorationReason    String?         @db.Text
  archivedAt           DateTime?

  case            Case                 @relation(fields: [caseId], references: [id])
  interviews      Interview[]
  statements      PartyStatement[]
  ownedStatements FinancialStatement[]
  knownAccounts   KnownAccount[]

  @@index([caseId, isDeleted])
  @@index([name])
  @@index([telephone])
}

// ═════════════════════ Invoices & cheques ═════════════════════

model Invoice {
  id                   String                      @id @default(cuid())
  caseId               String
  subFileId            String?
  invoiceNumber        String                      @db.VarChar(300)
  invoiceDate          DateTime
  customerName         String                      @db.VarChar(300)
  customerCode         String?                     @db.VarChar(300)
  salesLocation        String?                     @db.VarChar(300)
  deliveryLocation     String?                     @db.VarChar(300)
  invoiceAmount        Decimal                     @db.Decimal(18, 2)
  amountPaid           Decimal                     @default(0) @db.Decimal(18, 2)
  amountDisputed       Decimal                     @default(0) @db.Decimal(18, 2)
  amountAcknowledged   Decimal                     @default(0) @db.Decimal(18, 2)
  salesRepresentative  String?                     @db.VarChar(300)
  deliveryPerson       String?                     @db.VarChar(300)
  vehicleReference     String?                     @db.VarChar(300)
  deliveryNoteNumber   String?                     @db.VarChar(300)
  proofOfDelivery      ProofOfDeliveryStatus       @default(MISSING)
  erpPostingStatus     ErpPostingStatus            @default(UNKNOWN)
  customerVerification CustomerVerificationOutcome @default(NOT_CONTACTED)
  classification       InvoiceClassification       @default(REQUIRES_FURTHER_INVESTIGATION)
  observations         String?                     @db.MediumText
  responsiblePerson    String?                     @db.VarChar(300)
  recoveryStatus       RecoveryProgress            @default(NOT_STARTED)
  importBatchId        String?
  isDemo               Boolean                     @default(false)
  version              Int                         @default(1)
  createdById          String
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  isDeleted            Boolean                     @default(false)
  deletedAt            DateTime?
  deletedById          String?
  deletionReason       String?                     @db.Text
  deletionBatchId      String?
  restoredAt           DateTime?
  restoredById         String?
  restorationReason    String?                     @db.Text
  archivedAt           DateTime?

  case       Case            @relation(fields: [caseId], references: [id])
  subFile    SubFile?        @relation(fields: [subFileId], references: [id])
  cheques    ChequeInvoice[]
  recoveries Recovery[]

  @@index([caseId, isDeleted])
  @@index([invoiceNumber])
  @@index([customerName])
  @@index([invoiceDate])
  // The all-cases invoice register lists live invoices newest first. Without this index MariaDB
  // joins every visible case and sorts all their invoices to return one page (~800 ms at 100,000
  // invoices); with it, it reads the index in date order and stops after the page (~250 ms).
  @@index([isDeleted, archivedAt, invoiceDate])
}

model Cheque {
  id                      String                  @id @default(cuid())
  caseId                  String
  subFileId               String?
  chequeNumber            String                  @db.VarChar(300)
  bank                    String                  @db.VarChar(300)
  bankBranch              String?                 @db.VarChar(300)
  accountNumberMasked     String?                 @db.VarChar(300)
  accountName             String?                 @db.VarChar(300)
  chequeDate              DateTime?
  amount                  Decimal                 @db.Decimal(18, 2)
  dateReceived            DateTime?
  dateDeposited           DateTime?
  dateDishonoured         DateTime?
  dishonourReason         String?                 @db.VarChar(300)
  bankReturnReference     String?                 @db.VarChar(300)
  issuer                  String                  @db.VarChar(300)
  receivedByEmployee      String?                 @db.VarChar(300)
  status                  ChequeStatus            @default(RECEIVED)
  replacementChequeId     String?                 @unique
  demandLetterDate        DateTime?
  demandDeadline          DateTime?
  criminalComplaintStatus CriminalComplaintStatus @default(NOT_REPORTED)
  comments                String?                 @db.MediumText
  importBatchId           String?
  isDemo                  Boolean                 @default(false)
  version                 Int                     @default(1)
  createdById             String
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  isDeleted               Boolean                 @default(false)
  deletedAt               DateTime?
  deletedById             String?
  deletionReason          String?                 @db.Text
  deletionBatchId         String?
  restoredAt              DateTime?
  restoredById            String?
  restorationReason       String?                 @db.Text
  archivedAt              DateTime?

  case        Case            @relation(fields: [caseId], references: [id])
  subFile     SubFile?        @relation(fields: [subFileId], references: [id])
  replacement Cheque?         @relation("ChequeReplacement", fields: [replacementChequeId], references: [id])
  replaces    Cheque?         @relation("ChequeReplacement")
  invoices    ChequeInvoice[]
  recoveries  Recovery[]

  @@index([caseId, isDeleted])
  @@index([chequeNumber])
  @@index([status])
}

model ChequeInvoice {
  chequeId  String
  invoiceId String
  amount    Decimal @db.Decimal(18, 2)

  cheque  Cheque  @relation(fields: [chequeId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@id([chequeId, invoiceId])
}

// ═════════════════ Interviews & statements ═════════════════

model Interview {
  id                 String        @id @default(cuid())
  caseId             String
  partyId            String?
  interviewDate      DateTime
  location           String?       @db.VarChar(300)
  interviewers       String        @db.VarChar(300)
  personsPresent     String?       @db.Text
  interviewType      InterviewType
  questionsCovered   String?       @db.MediumText
  summaryOfResponses String?       @db.MediumText
  admissions         String?       @db.MediumText
  contradictions     String?       @db.MediumText
  documentsShown     String?       @db.MediumText
  followUpQuestions  String?       @db.MediumText
  signedStatementId  String?       @unique
  conclusion         String?       @db.MediumText
  nextAction         String?       @db.VarChar(300)
  isDemo             Boolean       @default(false)
  version            Int           @default(1)
  createdById        String
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  isDeleted          Boolean       @default(false)
  deletedAt          DateTime?
  deletedById        String?
  deletionReason     String?       @db.Text
  deletionBatchId    String?
  restoredAt         DateTime?
  restoredById       String?
  restorationReason  String?       @db.Text
  archivedAt         DateTime?

  case            Case            @relation(fields: [caseId], references: [id])
  party           Party?          @relation(fields: [partyId], references: [id])
  signedStatement PartyStatement? @relation(fields: [signedStatementId], references: [id])

  @@index([caseId, isDeleted])
}

model PartyStatement {
  id                String        @id @default(cuid())
  caseId            String
  partyId           String?
  kind              StatementKind
  statementDate     DateTime
  recordedBy        String        @db.VarChar(300)
  summary           String        @db.MediumText
  signed            Boolean       @default(false)
  evidenceId        String?       @unique
  isDemo            Boolean       @default(false)
  version           Int           @default(1)
  createdById       String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  isDeleted         Boolean       @default(false)
  deletedAt         DateTime?
  deletedById       String?
  deletionReason    String?       @db.Text
  deletionBatchId   String?
  restoredAt        DateTime?
  restoredById      String?
  restorationReason String?       @db.Text
  archivedAt        DateTime?

  case      Case       @relation(fields: [caseId], references: [id])
  party     Party?     @relation(fields: [partyId], references: [id])
  evidence  Evidence?  @relation(fields: [evidenceId], references: [id])
  interview Interview?

  @@index([caseId, isDeleted])
}

// ═════════════════════ Work-done log & tasks ═════════════════════

model WorkLog {
  id                   String                 @id @default(cuid())
  caseId               String
  subFileId            String?
  occurredAt           DateTime
  location             String?                @db.VarChar(300)
  investigatorId       String
  workPerformed        String                 @db.MediumText
  personContacted      String?                @db.VarChar(300)
  documentsReviewed    String?                @db.MediumText
  evidenceObtained     String?                @db.MediumText
  outcome              String?                @db.MediumText
  findings             String?                @db.MediumText
  amountVerified       Decimal?               @db.Decimal(18, 2)
  amountRecovered      Decimal?               @db.Decimal(18, 2)
  challenges           String?                @db.MediumText
  nextTask             String?                @db.VarChar(300)
  responsibleOfficerId String?
  dueDate              DateTime?
  completionDate       DateTime?
  status               WorkLogStatus          @default(OPEN)
  supervisorReview     String?                @db.MediumText
  supervisorStatus     SupervisorReviewStatus @default(PENDING)
  supervisorId         String?
  supervisorReviewedAt DateTime?
  importBatchId        String?
  isDemo               Boolean                @default(false)
  version              Int                    @default(1)
  createdById          String
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  isDeleted            Boolean                @default(false)
  deletedAt            DateTime?
  deletedById          String?
  deletionReason       String?                @db.Text
  deletionBatchId      String?
  restoredAt           DateTime?
  restoredById         String?
  restorationReason    String?                @db.Text
  archivedAt           DateTime?

  case               Case     @relation(fields: [caseId], references: [id])
  subFile            SubFile? @relation(fields: [subFileId], references: [id])
  investigator       User     @relation("WorkLogInvestigator", fields: [investigatorId], references: [id])
  responsibleOfficer User?    @relation("WorkLogResponsible", fields: [responsibleOfficerId], references: [id])
  followUps          Task[]

  @@index([caseId, occurredAt])
  @@index([caseId, isDeleted])
}

model Task {
  id                String       @id @default(cuid())
  reference         String       @unique @db.VarChar(300)
  caseId            String
  subFileId         String?
  title             String       @db.VarChar(300)
  description       String?      @db.MediumText
  category          TaskCategory @default(GENERAL)
  status            TaskStatus   @default(NOT_STARTED)
  priority          Priority     @default(MEDIUM)
  assigneeId        String?
  dueDate           DateTime?
  externalParty     String?      @db.VarChar(300)
  // Record the task follows up (CHEQUE, INVOICE, CRIMINAL_MATTER, CIVIL_MATTER, COURT_EVENT, FINDING …)
  linkType          String?      @db.VarChar(300)
  linkId            String?      @db.VarChar(300)
  sourceWorkLogId   String?
  completedAt       DateTime?
  importBatchId     String?
  isDemo            Boolean      @default(false)
  version           Int          @default(1)
  createdById       String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  isDeleted         Boolean      @default(false)
  deletedAt         DateTime?
  deletedById       String?
  deletionReason    String?      @db.Text
  deletionBatchId   String?
  restoredAt        DateTime?
  restoredById      String?
  restorationReason String?      @db.Text
  archivedAt        DateTime?

  case          Case     @relation(fields: [caseId], references: [id])
  subFile       SubFile? @relation(fields: [subFileId], references: [id])
  assignee      User?    @relation("TaskAssignee", fields: [assigneeId], references: [id])
  sourceWorkLog WorkLog? @relation(fields: [sourceWorkLogId], references: [id])

  @@index([assigneeId, status])
  @@index([dueDate])
  @@index([caseId, status])
  @@index([caseId, isDeleted])
  @@index([linkType, linkId])
}

// ═════════════════════ Files & evidence ═════════════════════

// Content stored under STORAGE_DIR with a random name. Originals are read-only forever.
model StoredFile {
  id           String   @id @default(cuid())
  sha256       String
  storageKey   String   @unique
  originalName String   @db.Text
  mimeType     String
  sizeBytes    Int
  readOnly     Boolean  @default(true)
  scanStatus   String   @default("NOT_SCANNED") // malware-scanning integration point
  uploadedById String
  createdAt    DateTime @default(now())

  @@index([sha256])
}

model Evidence {
  id                String           @id @default(cuid())
  reference         String           @unique @db.VarChar(300)
  caseId            String
  subFileId         String?
  sequence          Int
  title             String           @db.VarChar(300)
  category          EvidenceCategory
  source            String?          @db.VarChar(300)
  provider          String?          @db.VarChar(300)
  dateReceived      DateTime?
  uploadedById      String
  originalFileId    String           @unique
  sha256            String           @db.VarChar(300)
  originalFilename  String           @db.VarChar(300)
  confidentiality   Confidentiality  @default(CONFIDENTIAL)
  notes             String?          @db.MediumText
  legalHold         Boolean          @default(false)
  // Optional link to the record this evidence supports (INVOICE, CHEQUE, INTERVIEW, WORK_LOG, EXPENSE,
  // ADVANCE, RECOVERY, COURT_EVENT, CRIMINAL_MILESTONE, DISCIPLINARY, WRITE_OFF).
  linkType          String?          @db.VarChar(300)
  linkId            String?          @db.VarChar(300)
  isDemo            Boolean          @default(false)
  version           Int              @default(1)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  isDeleted         Boolean          @default(false)
  deletedAt         DateTime?
  deletedById       String?
  deletionReason    String?          @db.Text
  deletionBatchId   String?
  restoredAt        DateTime?
  restoredById      String?
  restorationReason String?          @db.Text
  archivedAt        DateTime?

  case       Case              @relation(fields: [caseId], references: [id])
  subFile    SubFile?          @relation(fields: [subFileId], references: [id])
  uploadedBy User              @relation("EvidenceUploader", fields: [uploadedById], references: [id])
  versions   EvidenceVersion[]
  accessLog  EvidenceAccess[]
  custody    CustodyEvent[]
  statement  PartyStatement?

  @@unique([caseId, sequence])
  @@index([sha256])
  @@index([linkType, linkId])
  @@index([caseId, isDeleted])
}

// Working copies. Version 1 is created from the original at upload; the original is never touched.
model EvidenceVersion {
  id          String   @id @default(cuid())
  evidenceId  String
  version     Int
  fileId      String   @unique
  sha256      String
  note        String?  @db.Text
  createdById String
  createdAt   DateTime @default(now())

  evidence Evidence @relation(fields: [evidenceId], references: [id])

  @@unique([evidenceId, version])
}

model EvidenceAccess {
  id         String               @id @default(cuid())
  evidenceId String
  userId     String
  action     EvidenceAccessAction
  detail     String?              @db.Text
  ipAddress  String?
  createdAt  DateTime             @default(now())

  evidence Evidence @relation(fields: [evidenceId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@index([evidenceId, createdAt])
  @@index([userId, createdAt])
}

model CustodyEvent {
  id           String   @id @default(cuid())
  evidenceId   String
  action       String // RECEIVED | TRANSFERRED | RETURNED | SUBMITTED_TO_AUTHORITY | STORED
  fromHolder   String?  @db.Text
  toHolder     String   @db.Text
  purpose      String   @db.Text
  occurredAt   DateTime
  recordedById String
  createdAt    DateTime @default(now())

  evidence   Evidence @relation(fields: [evidenceId], references: [id])
  recordedBy User     @relation(fields: [recordedById], references: [id])

  @@index([evidenceId])
}

// ═════════════ Findings, recommendations & decisions ═════════════

model Finding {
  id                     String              @id @default(cuid())
  caseId                 String
  subFileId              String?
  title                  String              @db.VarChar(300)
  allegations            String              @db.MediumText
  scopeCompleted         String?             @db.MediumText
  documentsReviewed      String?             @db.MediumText
  interviewsCompleted    String?             @db.MediumText
  financialAnalysis      String?             @db.MediumText
  factsEstablished       String?             @db.MediumText
  factsNotEstablished    String?             @db.MediumText
  controlFailures        String?             @db.MediumText
  confirmedAmount        Decimal             @default(0) @db.Decimal(18, 2)
  disputedAmount         Decimal             @default(0) @db.Decimal(18, 2)
  recoveredAmount        Decimal             @default(0) @db.Decimal(18, 2)
  unresolvedIssues       String?             @db.MediumText
  evidenceSufficiency    EvidenceSufficiency @default(PARTLY_SUFFICIENT)
  investigatorConclusion String?             @db.MediumText
  status                 FindingStatus       @default(DRAFT)
  submittedAt            DateTime?
  isDemo                 Boolean             @default(false)
  version                Int                 @default(1)
  createdById            String
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  isDeleted              Boolean             @default(false)
  deletedAt              DateTime?
  deletedById            String?
  deletionReason         String?             @db.Text
  deletionBatchId        String?
  restoredAt             DateTime?
  restoredById           String?
  restorationReason      String?             @db.Text
  archivedAt             DateTime?

  case            Case                 @relation(fields: [caseId], references: [id])
  subFile         SubFile?             @relation(fields: [subFileId], references: [id])
  recommendations Recommendation[]
  decisions       ManagementDecision[]

  @@index([caseId, isDeleted])
}

model Recommendation {
  id          String             @id @default(cuid())
  findingId   String
  type        RecommendationType
  details     String?            @db.Text
  // Set from the management decision: null = undecided.
  approved    Boolean?
  createdById String
  createdAt   DateTime           @default(now())

  finding Finding @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@unique([findingId, type])
}

model ManagementDecision {
  id           String          @id @default(cuid())
  findingId    String
  outcome      DecisionOutcome
  approverId   String
  decisionDate DateTime
  conditions   String?         @db.Text
  comments     String?         @db.Text
  createdAt    DateTime        @default(now())

  finding Finding @relation(fields: [findingId], references: [id])

  @@index([findingId])
}

// ═════════════════════ Legal pathways ═════════════════════

model CriminalMatter {
